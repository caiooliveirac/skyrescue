# Copie para .env.production NO SERVIDOR (não versionar).
# Postgres local no EC2:
DATABASE_URL=postgres://skyrescue:TROCAR_SENHA@127.0.0.1:5432/skyrescue

# Duração da sessão (horas). Padrão 12.
SESSION_TTL_HOURS=12

# Seed do admin inicial (usado só na 1ª migration, quando não há usuários):
SEED_ADMIN_USER=goa.samu
SEED_ADMIN_PASS=samu@192
